# ---------------------------------------------------------------------------
# Suspicious Photo Detection - environment overrides (placeholders only).
#
# Copy this file to `.env` (repository root) and fill in real values as needed.
# `.env` is gitignored and MUST never be committed (SPEC §17, §18).
#
# Non-secret tunables live in `src/config/settings.py`; only environment-specific
# overrides belong here. v1 requires NO secrets - the keys below are optional
# overrides of committed defaults, not credentials.
#
# Names mirror the fields of `src/config/settings.py` exactly.
# ---------------------------------------------------------------------------

# --- App / logging ---
# ENVIRONMENT=development
# LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- Model & embedding (SPEC §22.1) ---
# EMBEDDING_MODEL=dino_v2_small  # dino_v2_small (default) | clip
# EMBEDDING_DIM=384
# DEVICE=auto                    # auto | cpu | cuda | mps
# BATCH_SIZE=32
# DINO_V2_HUB_REPO=facebookresearch/dinov2
# DINO_V2_HUB_REF=7764ea0f912e53c92e82eb78a2a1631e92725fc8

# --- Paths (SPEC §22.3) ---
# DATASET_DIR=data/dataset
# OUTPUT_DIR=results
# CACHE_DIR=cache/embeddings
# LOG_DIR=logs

# --- Reproducibility (ED-6) ---
# RANDOM_SEED=42

# --- Scoring (SPEC §22.2) ---
# SIMILARITY_METRIC=cosine
# K_NEIGHBORS=5
# CENTROID_WEIGHT=0.3333333333333333
# KNN_WEIGHT=0.3333333333333333
# ISOLATION_FOREST_WEIGHT=0.3333333333333333
# MIN_IMAGES_FOR_ISOLATION_FOREST=10
# ISOLATION_FOREST_ESTIMATORS=100

# --- Detection (SPEC §22.2) ---
# MAD_K=3.0
# SCORE_FLOOR=0.5
# MIN_IMAGES_PER_OUTLET=2

# --- Dataset & output (SPEC §22.3) ---
# IGNORE_CORRUPT_IMAGES=false
# SCORE_DECIMALS=4
# WRITE_UP_MAX_CHARS=6000

# --- Untrusted-input bounds (SPEC §17) ---
# MAX_IMAGE_DIMENSION=8192
# MAX_IMAGE_PIXELS=50000000

# --- Synthetic-golden quality gates (SPEC §16) ---
# GOLDEN_MIN_PRECISION=0.8
# GOLDEN_MIN_RECALL=0.8
# GOLDEN_MIN_F1=0.8