# ---------------------------------------------------------------------------
# Suspicious Photo Detection - environment overrides (placeholders only).
#
# Copy this file to `.env` (repository root) and fill in real values as needed.
# `.env` is gitignored and MUST never be committed (SPEC §17, §18).
#
# Non-secret tunables live in `src/config/settings.py`; only environment-specific
# overrides belong here. v1 requires NO secrets - the keys below are optional
# overrides of committed defaults, not credentials.
#
# Names mirror the fields of `src/config/settings.py` exactly.
# ---------------------------------------------------------------------------

# --- App / logging ---
# ENVIRONMENT=dev
# LOG_LEVEL=INFO

# --- Device & model (override settings.py defaults) ---
# DEVICE=auto             # auto | cpu | cuda | mps
# EMBEDDING_MODEL=dino_v2_small   # dino_v2_small (default) | clip

# --- Paths ---
# DATASET_DIR=data/dataset
# OUTPUT_DIR=results
# CACHE_DIR=cache/embeddings

# --- Reproducibility ---
# RANDOM_SEED=42
