# Container runtime lockfile input (CPU-only torch).
#
# Rationale: the pipeline runs batch inference on CPU (`device: cpu`), so the
# CUDA-flavoured torch that the main `requirements.txt` pins (PyPI default)
# would pull several GB of nvidia/cuda wheels into the container image for
# nothing. This lockfile pins the SAME torch/torchvision versions (2.14.0 /
# 0.29.0) but the CPU wheels from the official PyTorch index; every other
# runtime dependency resolves exactly as in `requirements.txt`. Embedding
# output is bit-identical (same weights, same ops).
#
# Regenerate with:
#   uv pip compile requirements-docker.in -o requirements-docker.txt \
#     --emit-index-url
--index-url https://download.pytorch.org/whl/cpu
--extra-index-url https://pypi.org/simple

# Runtime deps (mirror [project.dependencies] in pyproject.toml).
numpy>=1.26
scipy>=1.12
scikit-learn>=1.4
pillow>=10.0
pydantic>=2.7,<3
pydantic-settings>=2.2
typer>=0.12
structlog>=24.1

# CPU-flavoured torch/torchvision pinned to the exact versions used locally.
torch==2.14.0+cpu
torchvision==0.29.0+cpu